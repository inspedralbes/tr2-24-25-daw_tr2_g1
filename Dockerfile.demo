FROM node:24-bookworm-slim AS frontend
WORKDIR /build/frontend
COPY frontend/package*.json ./
RUN npm ci --ignore-scripts
COPY frontend/ ./
ENV NUXT_PUBLIC_DEMO_MODE=true API_ORIGIN=http://127.0.0.1:3001
RUN npm run build

FROM node:24-bookworm-slim AS backend
WORKDIR /build/backend
COPY backend/package*.json ./
RUN npm ci --omit=dev --ignore-scripts
COPY backend/ ./

FROM node:24-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends nginx supervisor gettext-base \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=frontend /build/frontend/.output /app/frontend/.output
COPY --from=backend /build/backend /app/backend
COPY deploy/nginx.conf.template /etc/nginx/templates/demo.conf.template
COPY deploy/supervisord.conf /etc/supervisor/conf.d/demo.conf
COPY deploy/entrypoint.sh /usr/local/bin/plapi-demo
RUN chmod +x /usr/local/bin/plapi-demo && mkdir -p /app/backend/uploads
ENV NODE_ENV=production DEMO_MODE=true NUXT_PUBLIC_DEMO_MODE=true DB_NAME=plapi_demo DB_SSL=true DB_PORT=4000 \
 PORT=10000 PORT_BACKEND=3001 HOST=127.0.0.1 NITRO_HOST=127.0.0.1 NITRO_PORT=3000
EXPOSE 10000
ENTRYPOINT ["plapi-demo"]
